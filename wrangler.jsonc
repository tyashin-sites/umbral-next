{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name; registered as projects.workerDeployment.scriptName via /adopt.
  "name": "site-umbral-next",
  "main": ".open-next/worker.js",
  "tail_consumers": [{ "service": "aapastech-security-log-tail" }],
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Shared platform ISR cache namespace (addendum: SHARED_NEXT_INC_CACHE_KV_ID).
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "426d3a7563b14b9ab194d8495ae1c7ef" }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "site-umbral-next" }],
  "durable_objects": { "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "TYASHIN_API_URL": "https://website-api.tyashin.com",
    "PROJECT_ID": "6ae9556c0d304c5ad2874e1d",
    "PROJECT_SLUG": "doors-website",
    // Demo house: stays noindex on the slug host. Flip at a real cutover only.
    "ROBOTS_NOINDEX": "true"
  }
  // Secret (deploy.yml secret sync): TYASHIN_API_KEY — the project's public X-API-Key.
}
